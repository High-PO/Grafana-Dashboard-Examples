          "legendFormat": "시간당",
          "refId": "A"
        }
      ],
      "title": "시간당",
      "description": "노드 전체를 AWS 온디맨드로 돌렸을 때의 시간당 비용",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "repeatDirection": "h",
      "options": {
