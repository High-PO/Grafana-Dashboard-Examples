      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(container_cpu_usage_seconds_total{container!=\"\", container!=\"POD\"}[10m])) / sum(container_cpu_allocation)",
          "legendFormat": "CPU 효율",
          "refId": "A"
        }
      ],
      "title": "CPU 효율",
      "description": "할당된 리소스 중 실제로 쓰이는 비율. 낮을수록 request 과다 설정.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "repeatDirection": "h",
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "percentChangeColorMode": "standard",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 0.3,
                "color": "orange"
              },
              {
                "value": 0.5,
                "color": "green"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "collapsed": false,
      "title": "네임스페이스별",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "id": 7,
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 8,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by(namespace) (container_cpu_allocation{namespace=~\"$namespace\"} * on(node) group_left() avg by(node) (node_cpu_hourly_cost)) * 730\n+\nsum by(namespace) (container_memory_allocation_bytes{namespace=~\"$namespace\"} / 1024 / 1024 / 1024 * on(node) group_left() avg by(node) (node_ram_hourly_cost)) * 730",
          "legendFormat": "{{namespace}}",
          "refId": "A"
        }
      ],
      "title": "네임스페이스별 월 환산 비용",
      "description": "각 네임스페이스가 점유한 CPU/메모리를 AWS 단가로 환산한 월 비용",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 10,
        "w": 14,
        "x": 0,
        "y": 6
