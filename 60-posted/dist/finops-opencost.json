          "format": "table",
          "instant": true,
          "range": false,
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(sum by(namespace) (container_cpu_allocation{namespace=~\"$namespace\"} * on(node) group_left() avg by(node) (node_cpu_hourly_cost))\n+\nsum by(namespace) (container_memory_allocation_bytes{namespace=~\"$namespace\"} / 1024 / 1024 / 1024 * on(node) group_left() avg by(node) (node_ram_hourly_cost))) * 730",
          "format": "table",
