  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "datasource",
        "label": "Datasource",
        "skipUrlSync": false,
        "query": "prometheus",
        "multi": false,
        "allowCustomValue": true,
        "includeAll": false,
        "auto": false,
        "auto_min": "10s",
        "auto_count": 30
      },
      {
        "type": "query",
        "name": "namespace",
        "label": "Namespace",
        "skipUrlSync": false,
        "query": {
          "query": "label_values(kube_pod_info, namespace)",
          "refId": "StandardVariableQuery"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "multi": false,
        "allowCustomValue": true,
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "auto": false,
        "auto_min": "10s",
        "auto_count": 30,
        "definition": "label_values(kube_pod_info, namespace)"
      },
      {
        "type": "query",
        "name": "workload",
        "label": "Workload",
        "skipUrlSync": false,
        "description": "Deployment / StatefulSet / DaemonSet 이름. ReplicaSet 해시는 정규식으로 잘라냅니다.",
        "query": {
          "query": "label_values(kube_pod_info{namespace=\"$namespace\"}, created_by_name)",
          "refId": "StandardVariableQuery"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "multi": false,
        "allowCustomValue": true,
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "regex": "/^(.+?)(?:-[bcdfghjklmnpqrstvwxz2456789]{6,10})?$/",
        "auto": false,
        "auto_min": "10s",
        "auto_count": 30,
        "definition": "label_values(kube_pod_info{namespace=\"$namespace\"}, created_by_name)"
      },
      {
        "type": "query",
        "name": "pod",
        "label": "Pod",
        "skipUrlSync": false,
        "query": {
          "query": "label_values(kube_pod_info{namespace=\"$namespace\", pod=~\"$workload-.*\"}, pod)",
          "refId": "StandardVariableQuery"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "current": {
          "text": "All",
